# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.

# PostgreSQL. Local (docker compose): ver valor de ejemplo.
# Producción (Neon): usa la cadena POOLED (host con "-pooler").
DATABASE_URL=postgres://recetario:recetario@localhost:5432/recetario

# Secreto para firmar la cookie de acceso (HS256). Mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# Clave para cifrar los códigos de familia (AES-256-GCM + índice HMAC). Mínimo 32 caracteres.
# Genera una con: openssl rand -base64 48. Si la pierdes o la cambias, los códigos existentes dejan de funcionar.
ACCESS_CODE_KEY=

# Máximo de recetarios que se pueden crear. 0 = cerrar la creación (interruptor de emergencia).
MAX_HOUSEHOLDS=200

# Nombre de tu cuenta de Cloudinary (Dashboard → "Cloud name"). Opcional: sin él las recetas no muestran fotos ni videos.
CLOUDINARY_CLOUD_NAME=

# Secreto del cron de purga (Vercel lo envía como Bearer). Genera uno con: openssl rand -base64 32
CRON_SECRET=

# Rate limit con Upstash Redis (en Vercel basta la integración: también se leen KV_REST_API_URL y KV_REST_API_TOKEN). Opcional en desarrollo: sin esto usa memoria y avisa en el log).
# Obligatorio en producción (Vercel es serverless: la memoria no se comparte entre instancias).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
